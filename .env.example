# Tumaini · TBHOS — environment template
#
# Tumaini shares the THOS Supabase project (Laetoli (T) Ltd Pro tier) until
# Laetoli Data (sovereign self-hosted, Tanzania) is live. Tables are namespaced
# `tr_*` so they never collide with THOS tables. Both products share auth.users.
#
# To run locally: copy this file to .env and fill in the values.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<anon-jwt>

# Shared password for the demo persona chips on the entrance.
#
# Unset is a valid state: the chips still switch persona, they just do not sign
# in to the backend. Vite inlines this into the bundle, so it is public to
# anyone who reads the JavaScript. Never set it to a password used anywhere
# else, and never give a demo account a role above `citizen`.
VITE_DEMO_PASSWORD=<demo-only-password>
