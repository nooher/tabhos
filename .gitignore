node_modules
dist

# TypeScript's incremental build cache. It was tracked, so every build dirtied
# the working tree and made real changes harder to see.
*.tsbuildinfo
.DS_Store
*.log

# Local env (THOS Supabase credentials) — never commit
.env
.env.local
.env.production.local
tmp-kb/

# Supabase CLI scratch state: project ref, pooler URL, and the exact patch
# versions of the running stack. No credential, but nothing here is source and
# the version numbers are free reconnaissance.
supabase/.temp/
